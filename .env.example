# Copy this file to .env and fill in your own API keys.
DASHSCOPE_API_KEY=
DEEPSEEK_API=
PAPERAGENT_CHAT_MODEL=deepseek-chat

# Conservative UTF-8 byte budgets for model inputs. Check API usage for actual tokens.
PAPERAGENT_CONTEXT_INPUT_TOKENS=16000
PAPERAGENT_CONTEXT_OUTPUT_TOKENS=2048
PAPERAGENT_HISTORY_TOKENS=4000
PAPERAGENT_SUMMARY_TOKENS=1200
PAPERAGENT_EVIDENCE_TOKENS=8000
PAPERAGENT_RECENT_TURNS=3

# Local OCR runs on CPU. Scheme 3 also uses the configured VLM endpoint.
PAPERAGENT_OCR_THREADS=2
PAPERAGENT_OCR_MIN_CONFIDENCE=0.5
PAPERAGENT_OCR_MATCH_THRESHOLD=0.5
PAPERAGENT_VLM_MODEL=qwen3-vl-flash
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional local settings. Relative paths resolve from the startup directory.
# PAPERAGENT_SERVICE_ROOT=./pdfprocess/data/upload_service
# PAPERAGENT_INGEST_ROOT=./pdfprocess/data/ingestion
# PAPERAGENT_CHROMA_DIR=./pdfprocess/data/chroma_db
PAPERAGENT_UPLOAD_WORKERS=1
PAPERAGENT_PARSE_PROCESSES=1
PAPERAGENT_UPLOAD_MAX_MB=50
PAPERAGENT_SQLITE_JOURNAL_MODE=WAL
# PAPERAGENT_RERANKER_MODEL_DIR=./pdfprocess/data/models/mmarco-minilm
